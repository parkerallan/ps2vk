;   VF19 texture coordinate output (S, T, Q, or U, V)
;   VF25-VF26 the previous two screen positions (culling)
;   VF05-VF09, VF18-VF19, VF27-VF31 push constants, uniforms, constants and temporaries
;   VI02 vertices left, VI03 input pointer, VI04 output base, VI05 output pointer
;   VI06 index pointer, VI07-VI08 index scaling, VI09 index list offset (0 = in order),
;   VI10 first vertex, VI11 vertices to the next triangle, VI12 vertices per triangle
;   (0 = no culling), VI14 MAC flag mask, VI15 fan

		.vu
		.align 4
		.global	tex_swizzle_vert_CodeStart
		.global	tex_swizzle_vert_CodeEnd
tex_swizzle_vert_CodeStart:
; prologue: constants, batch header, GIF tag to the output
         NOP                                      lq            VF01,0(VI00)
         NOP                                      lq            VF02,1(VI00)
         NOP                                      lq            VF03,2(VI00)
         NOP                                      iaddiu        VI01,VI00,80               ; input base
         NOP                                      lq            VF04,0(VI01)               ; GIF tag for this batch
         NOP                                      ilw.x         VI02,1(VI01)               ; vertex count
         NOP                                      iaddiu        VI03,VI01,2                ; first vertex
         NOP                                      ilw.y         VI09,1(VI01)               ; index list offset, 0 = vertices in order
         NOP                                      iadd          VI10,VI03,VI00             ; first vertex, kept for indexed fetches
         NOP                                      iadd          VI06,VI01,VI09             ; index pointer
         NOP                                      iaddiu        VI04,VI00,512              ; output base
         sub.xyzw      VF23,VF00,VF00             sq            VF04,0(VI04)               ; XYZ2 w = 0 (ADC off)
         NOP                                      iaddiu        VI05,VI04,1                ; output pointer
         NOP                                      iaddiu        VI11,VI00,3                ; the third vertex completes the first triangle
         NOP                                      ilw.z         VI12,3(VI00)               ; vertices per triangle, 0 = no culling
         NOP                                      ilw.y         VI15,3(VI00)               ; 1 for a fan
         NOP                                      iaddiu        VI14,VI00,0x20             ; MAC flag: z negative
; constants
         sub.xyzw      VF05,VF00,VF00             NOP                                      ; float constant
         NOP                                      loi           0x40000000                 ; 2
         addi.x        VF05,VF05,I                NOP
tex_swizzle_vert_loop:
; indexed batch: the next vertex is first vertex + index * 3
         NOP                                      ibeq          VI09,VI00,tex_swizzle_vert_fetch ; vertices in order: VI03 already points at the next one
         NOP                                      NOP                                      ; branch delay slot
         NOP                                      ilw.x         VI07,0(VI06)               ; index
         NOP                                      iaddiu        VI06,VI06,1
         NOP                                      iadd          VI08,VI00,VI07             ; index * qwords per vertex
         NOP                                      iadd          VI07,VI07,VI07
         NOP                                      iadd          VI08,VI08,VI07
         NOP                                      iadd          VI03,VI10,VI08             ; vertex it refers to
tex_swizzle_vert_fetch:
; load inputs (location order)
         NOP                                      lq            VF10,0(VI03)               ; location 0
         NOP                                      lq            VF11,1(VI03)               ; location 1
         NOP                                      lq            VF12,2(VI03)               ; location 2
; shader body
         addy.x        VF06,VF00,VF12y            NOP                                      ; line 16: OpVectorShuffle (a swizzle)
         addx.y        VF06,VF00,VF12x            NOP
         mulx.xy       VF06,VF06,VF05x            NOP                                      ; line 16: OpVectorTimesScalar (vector * scalar)
         NOP                                      move.xyzw     VF20,VF10                  ; gl_Position
         NOP                                      move.xyzw     VF21,VF11                  ; color output, location 0
         NOP                                      move.xy       VF19,VF06                  ; texture coordinate output, location 1
; epilogue: perspective divide, viewport, GS formats, store
         NOP                                      ilw.w         VI13,1(VI01)               ; 1 = UV in texels (PRIM.FST)
         NOP                                      div           Q,VF00w,VF20w              ; Q = 1 / w
         NOP                                      waitq
         mulq.xyz      VF22,VF20,Q                NOP
         NOP                                      ibne          VI13,VI00,tex_swizzle_vert_uv
         NOP                                      NOP                                      ; branch delay slot
         mulq.xy       VF19,VF19,Q                NOP                                      ; S / w, T / w
         NOP                                      b             tex_swizzle_vert_st
         addq.z        VF19,VF00,Q                NOP                                      ; delay slot: Q = 1 / w
tex_swizzle_vert_uv:
         ftoi4.xy      VF19,VF19                  NOP                                      ; U, V to 12.4 fixed point
tex_swizzle_vert_st:
         mul.xyz       VF22,VF22,VF01             NOP                                      ; viewport scale
         add.xyz       VF22,VF22,VF02             NOP                                      ; viewport offset
         ftoi4.xy      VF23,VF22                  NOP                                      ; x, y to 12.4 fixed point
         ftoi0.z       VF23,VF22                  NOP                                      ; z to integer depth
         mul.xyzw      VF24,VF21,VF03             NOP                                      ; color 0..1 to GS range
         ftoi0.xyzw    VF24,VF24                  NOP
         NOP                                      sq            VF19,0(VI05)               ; ST (and Q), or UV
         NOP                                      sq            VF24,1(VI05)               ; RGBAQ
; culling: test the triangle this vertex completes
         sub.w         VF23,VF00,VF00             isubiu        VI11,VI11,1                ; ADC off; one vertex closer to a triangle
         NOP                                      ibeq          VI12,VI00,tex_swizzle_vert_xyz ; no culling
         NOP                                      NOP                                      ; branch delay slot
         NOP                                      ibne          VI11,VI00,tex_swizzle_vert_shift ; triangle not complete yet
         NOP                                      NOP                                      ; branch delay slot
         sub.xy        VF20,VF26,VF25             iadd          VI11,VI12,VI00             ; P1 - P0; vertices to the next triangle
         sub.xy        VF21,VF22,VF25             lq            VF24,1(VI01)               ; P2 - P0; batch header, z = winding sign
         opmula.xyz    ACC,VF20,VF21              NOP
         opmsub.xyz    VF20,VF21,VF20             NOP                                      ; z = signed area
         mul.z         VF20,VF20,VF24             lq            VF21,3(VI00)               ; area * sign, negative = cull; cull context
         NOP                                      NOP                                      ; MAC flags land 4 cycles later
         NOP                                      NOP
         NOP                                      NOP
         NOP                                      NOP
         mulx.z        VF24,VF24,VF21             fmand         VI13,VI14                  ; next triangle's sign; sign flag of z
         NOP                                      sq            VF24,1(VI01)
         NOP                                      ibeq          VI13,VI00,tex_swizzle_vert_shift ; front facing: draw
         NOP                                      ilw.w         VI13,3(VI00)               ; delay slot: ADC bit
         NOP                                      NOP
         NOP                                      mfir.w        VF23,VI13                  ; ADC on: the GS keeps the vertex but draws nothing
tex_swizzle_vert_shift:
         NOP                                      isubiu        VI13,VI11,2                ; 0 at the batch's first vertex
         NOP                                      ibeq          VI15,VI00,tex_swizzle_vert_p0 ; not a fan: P0 <- P1
         NOP                                      NOP                                      ; branch delay slot
         NOP                                      ibne          VI13,VI00,tex_swizzle_vert_p1 ; a fan's P0 stays its hub
         NOP                                      NOP                                      ; branch delay slot
         NOP                                      move.xy       VF25,VF22                  ; the hub
         NOP                                      b             tex_swizzle_vert_p1
         NOP                                      NOP                                      ; branch delay slot
tex_swizzle_vert_p0:
         NOP                                      move.xy       VF25,VF26
tex_swizzle_vert_p1:
         NOP                                      move.xy       VF26,VF22                  ; P1 <- this vertex
tex_swizzle_vert_xyz:
         NOP                                      sq            VF23,2(VI05)               ; XYZ2 (draws unless ADC is set)
         NOP                                      iaddiu        VI05,VI05,3
         NOP                                      iaddiu        VI03,VI03,3
         NOP                                      isubiu        VI02,VI02,1
         NOP                                      NOP
         NOP                                      ibne          VI02,VI00,tex_swizzle_vert_loop
         NOP                                      NOP                                      ; branch delay slot
; send the batch to the GS and stop
         NOP                                      xgkick        VI04
         NOP[E]                                   NOP
         NOP                                      NOP
		.align 4
tex_swizzle_vert_CodeEnd:
