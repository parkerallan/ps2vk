#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_control_flow_attributes : require

// A closed ring of 24 lines, written by a loop VU1 runs as a loop.
layout(local_size_x = 1) in;
layout(lines, max_vertices = 24, max_primitives = 24) out;

layout(location = 0) out vec4 vColor[];

void main()
{
    SetMeshOutputsEXT(24, 24);
    [[dont_unroll]] for (int i = 0; i < 24; i++) {
        float a = float(i) * 0.2617994;
        gl_MeshVerticesEXT[i].gl_Position = vec4(0.5 + 0.12 * cos(a), 0.3 + 0.16 * sin(a), 0.5, 1.0);
        vColor[i] = vec4(1.0, float(i) * 0.04, 0.2, 1.0);
        gl_PrimitiveLineIndicesEXT[i] = uvec2(i, i < 23 ? i + 1 : 0);
    }
}
