#version 450
#extension GL_EXT_mesh_shader : require

// Two invocations each write a share of the mesh work group count; behind the barrier() both read
// the sum, so the count is the same whichever invocation's EmitMeshTasksEXT is taken.
layout(local_size_x = 2) in;

struct Payload {
    vec4 origin;
};
taskPayloadSharedEXT Payload payload;

shared uint part[2];

void main()
{
    uint i = gl_LocalInvocationIndex;

    part[i] = i + 1u + gl_WorkGroupID.x;
    barrier();
    if (i == 0u)
        payload.origin = vec4(-0.5 + 0.5 * float(gl_WorkGroupID.x), 0.0, 0.5, 1.0);
    EmitMeshTasksEXT(part[0] + part[1], 1u, 1u);
}
