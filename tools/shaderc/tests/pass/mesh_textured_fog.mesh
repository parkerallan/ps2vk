#version 450
#extension GL_EXT_mesh_shader : require

// A textured quad tinted per vertex that fades into the fog color from top to bottom.
layout(local_size_x = 1) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;

layout(location = 0) out vec4 vColor[];
layout(location = 1) out vec2 vUV[];
layout(location = 2) out float vFog[];

void main()
{
    SetMeshOutputsEXT(4, 2);
    gl_MeshVerticesEXT[0].gl_Position = vec4(-0.35, 0.2, 0.5, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(0.0, 0.2, 0.5, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(-0.35, 0.65, 0.5, 1.0);
    gl_MeshVerticesEXT[3].gl_Position = vec4(0.0, 0.65, 0.5, 1.0);
    vColor[0] = vec4(1.0, 0.3, 0.3, 1.0);
    vColor[1] = vec4(0.3, 1.0, 0.3, 1.0);
    vColor[2] = vec4(0.3, 0.3, 1.0, 1.0);
    vColor[3] = vec4(1.0, 1.0, 1.0, 1.0);
    vUV[0] = vec2(0.0, 0.0);
    vUV[1] = vec2(2.0, 0.0);
    vUV[2] = vec2(0.0, 2.0);
    vUV[3] = vec2(2.0, 2.0);
    vFog[0] = 1.0;
    vFog[1] = 1.0;
    vFog[2] = 0.0;
    vFog[3] = 0.0;
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(2, 1, 3);
}
